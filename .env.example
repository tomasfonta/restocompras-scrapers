# Flask Configuration
FLASK_ENV=dev
FLASK_PORT=5000
FLASK_DEBUG=True

# API Security
API_KEY_SECRET=your-secret-api-key-change-this-in-production

# Environment (dev/prod)
ENV=dev

# API Configuration (for scraper backend integration)
API_BASE_URL=http://localhost:8000
API_TIMEOUT=30

# Optional: Logging
LOG_LEVEL=INFO
